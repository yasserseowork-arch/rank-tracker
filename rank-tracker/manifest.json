{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "version": "1.14.0",
  "default_locale": "ar",
  "description": "__MSG_appDesc__",
  "minimum_chrome_version": "116",
  "author": "Muhammed Yasser",
  "homepage_url": "https://github.com/mohamed-yasser/rank-tracker",
  "author": "SEO Rank Automation Lab",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel",
    "notifications",
    "browsingData",
    "debugger"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.sa/*",
    "https://www.google.com.sa/*",
    "https://docs.google.com/*",
    "https://consent.google.com/*",
    "*://www.google.com/recaptcha/*",
    "*://recaptcha.net/*",
    "*://www.recaptcha.net/*",
    "*://www.gstatic.com/recaptcha/*"
  ],
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/side-panel.html"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://google.com/search*",
        "https://www.google.sa/search*",
        "https://google.sa/search*",
        "https://www.google.com.sa/search*",
        "https://google.com.sa/search*"
      ],
      "js": [
        "src/lib/constants.js",
        "src/lib/messaging.js",
        "src/lib/dom.js",
        "src/lib/url.js",
        "src/lib/errorsig.js",
        "src/lib/matchlib.js",
        "src/content/serp.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.google.com/sorry/*",
        "https://google.com/sorry/*",
        "https://www.google.sa/sorry/*",
        "https://google.sa/sorry/*",
        "https://www.google.com.sa/sorry/*",
        "https://google.com.sa/sorry/*",
        "*://www.google.com/recaptcha/*",
        "*://google.com/recaptcha/*",
        "*://recaptcha.net/*",
        "*://www.recaptcha.net/*",
        "*://www.gstatic.com/recaptcha/*"
      ],
      "js": [
        "src/lib/constants.js",
        "src/lib/messaging.js",
        "src/lib/dom.js",
        "src/lib/url.js",
        "src/content/captcha.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "src/lib/constants.js",
        "src/lib/messaging.js",
        "src/lib/dom.js",
        "src/content/sheets-writer.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://consent.google.com/*"
      ],
      "js": [
        "src/lib/dom.js",
        "src/content/consent.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
