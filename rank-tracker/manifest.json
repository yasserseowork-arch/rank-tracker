{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "version": "1.19.9",
  "default_locale": "ar",
  "description": "__MSG_appDesc__",
  "minimum_chrome_version": "123",
  "homepage_url": "https://github.com/mohamed-yasser/rank-tracker",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel",
    "notifications",
    "browsingData",
    "debugger",
    "webRequest",
    "declarativeNetRequest",
    "webNavigation",
    "offscreen",
    "cookies",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.sa/*",
    "https://www.google.com.sa/*",
    "https://docs.google.com/*",
    "https://consent.google.com/*",
    "*://www.google.com/recaptcha/*",
    "*://recaptcha.net/*",
    "*://www.recaptcha.net/*",
    "*://www.gstatic.com/recaptcha/*",
    "<all_urls>",
    "https://www.google.com/",
    "https://maps.google.com/",
    "https://photon.komoot.io/"
  ],
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/side-panel.html"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://google.com/search*",
        "https://www.google.sa/search*",
        "https://google.sa/search*",
        "https://www.google.com.sa/search*",
        "https://google.com.sa/search*"
