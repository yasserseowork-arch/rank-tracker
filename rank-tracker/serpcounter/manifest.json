{
  "manifest_version": 3,
  "name": "CountMe — SERP Counter",
  "version": "1.0.1",
  "description": "يرقّم نتائج جوجل الخضرا على صفحة النتائج — المصدر الرسمي لرقم الترتيب لأداة SEO Kw Tracker.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CountMe — SERP Counter"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*", "https://www.google.com.sa/search*", "https://www.google.sa/search*", "https://www.google.com.eg/search*", "https://www.google.eg/search*", "https://www.google.ae/search*", "https://www.google.com.ae/search*", "https://www.google.co.uk/search*", "https://www.google.de/search*", "https://www.google.fr/search*", "https://www.google.tr/search*", "https://www.google.co.in/search*", "https://www.google.com.tr/search*", "https://google.com/search*", "https://google.com.sa/search*", "https://google.sa/search*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
